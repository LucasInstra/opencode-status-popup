{
  "name": "opencode-status-popup",
  "version": "0.1.0",
  "description": "Always-on-top status pill (or tray icon) for OpenCode that types \"opencode\" while an agent is thinking.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "opencode": ">=2"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "host",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "vitest run tests/smoke.test.ts",
    "preview": "node scripts/preview.mjs",
    "preview:tray": "node scripts/preview.mjs --mode tray",
    "preview:stop": "node scripts/preview.mjs --stop"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
